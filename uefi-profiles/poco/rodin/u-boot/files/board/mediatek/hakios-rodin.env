# Minimal RAM-only U-Boot environment for POCO X7 Pro (rodin / MT6899).
bootdelay=0
bootretry=1
stdin=nulldev
stdout=vidconsole
stderr=vidconsole

bootcmd=echo "[rodin] bootcmd start"; if test -n "${hakios_hkub_addr}"; then echo "[rodin] hakios load ${hakios_hkub_addr} ${hakios_hkub_size}"; if hakios load ${hakios_hkub_addr} ${hakios_hkub_size}; then rodin_mark ok; echo "[rodin] starting loader.efi via hakios boot..."; hakios boot; fi; elif hakios load; then rodin_mark ok; echo "[rodin] starting loader.efi via hakios boot..."; hakios boot; fi; rodin_mark fail; echo "[rodin] hakios load/boot FAILED or returned:"; hakios info; echo "[rodin] Hold power button to reboot to Android"; while true; do sleep 3600; done
